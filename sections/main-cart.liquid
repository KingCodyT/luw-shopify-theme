<section class="cart-shell">
  <div class="section-heading">
    <p class="eyebrow">Cart</p>
    <h1>Your canvases</h1>
  </div>

  {% if cart == empty %}
    <p>Your cart is empty.</p>
    <a class="button button--primary" href="{{ routes.collections_url }}">Browse drops</a>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" class="cart-form">
      {% for item in cart.items %}
        <article class="cart-item">
          <a href="{{ item.url }}" class="cart-item__image">
            {% render 'responsive-image',
              image: item.image,
              sizes: '160px',
              class: 'cart-item__img'
            %}
          </a>
          <div class="cart-item__content">
            <h2>{{ item.product.title }}</h2>
            <p>{{ item.variant.title }}</p>
            <label>
              Qty
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0">
            </label>
          </div>
          <p class="cart-item__price">{{ item.final_line_price | money }}</p>
        </article>
      {% endfor %}

      <div class="cart-summary">
        <p>Total {{ cart.total_price | money }}</p>
        <button class="button button--quiet" type="submit" name="update">Update</button>
        <button class="button button--primary" type="submit" name="checkout">Checkout</button>
      </div>
    </form>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart"
}
{% endschema %}
