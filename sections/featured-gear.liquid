{% comment %} Featured Gear section {% endcomment %}
<section class="featured-gear">
  {% if section.settings.hero_image != blank %}
    <div class="featured-gear__hero">
      {% render 'responsive-image',
        image: section.settings.hero_image,
        sizes: '100vw',
        class: 'featured-gear__hero-image',
        loading: 'lazy'
      %}
    </div>
  {% endif %}
  <div class="featured-gear__header">
    <p class="featured-gear__eyebrow">
      {{ section.settings.eyebrow }}
    </p>

    <h2 class="featured-gear__heading">
      {{ section.settings.heading }}
    </h2>

    {% if section.settings.text != blank %}
      <p class="featured-gear__text">
        {{ section.settings.text }}
      </p>
    {% endif %}
  </div>

  <div class="featured-gear__grid">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}

      {% if product != blank %}
        <a
          class="featured-gear__card"
          href="{{ product.url }}"
          {{ block.shopify_attributes }}
        >
          <div class="featured-gear__image-wrap">
            {% if product.featured_image %}
              {% render 'responsive-image',
                image: product.featured_image,
                sizes: '(min-width: 990px) 25vw, 50vw',
                class: 'featured-gear__image'
              %}
            {% endif %}
          </div>

          <div class="featured-gear__content">
            <h3 class="featured-gear__title">
              {{ product.title }}
            </h3>

            <p class="featured-gear__price">
              {{ product.price | money }}
            </p>
          </div>
        </a>
      {% endif %}
    {% endfor %}
  </div>

  {% if section.settings.show_shop_all %}
    <div class="featured-gear__footer">
      <a
        class="featured-gear__shop-all"
        href="{{ routes.all_products_collection_url }}"
      >
        {{ section.settings.shop_all_label }}
      </a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Featured gear",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Featured Gear Hero Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FEATURED GEAR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WEAR THE LYFE."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A few favorites worth wearing right now."
    },
    {
      "type": "checkbox",
      "id": "show_shop_all",
      "label": "Show Shop All link",
      "default": true
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "Shop All label",
      "default": "SHOP ALL →"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Featured gear",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
