<section class="search-shell">
  <div class="section-heading">
    <p class="eyebrow">Search</p>
    <h1>Find artwork.</h1>
  </div>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Artwork, drop, canvas">
    <button class="button button--primary" type="submit">Search</button>
  </form>

  {% if search.performed %}
    <div class="collection-artwork__grid">
      {% for item in search.results %}
        {% if item.object_type == 'product' %}
          {% render 'artwork-tile', product: item %}
        {% else %}
          <a class="search-result" href="{{ item.url }}">
            <span class="eyebrow">{{ item.object_type }}</span>
            <h2>{{ item.title }}</h2>
          </a>
        {% endif %}
      {% else %}
        <p>No results found.</p>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Search"
}
{% endschema %}
