<section class="search-shell{% if search.performed %} search-shell--results{% endif %}">
  <div class="section-heading">
    <h1>Find Your LYFE.</h1>
  </div>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="What’s Your LYFE?">
    <button class="button button--primary" type="submit">Search</button>
  </form>
  {% if section.settings.banner_image != blank and search.performed == false %}
    <div class="search-banner">
      {% render 'responsive-image',
        image: section.settings.banner_image,
        sizes: '100vw',
        loading: 'eager',
        class: 'search-banner__image'
      %}
    </div>
  {% endif %}

  {% if search.performed %}
    <div class="collection-artwork__grid">
      {% for item in search.results %}
        {% if item.object_type == 'product' %}
          {% render 'artwork-tile', product: item %}
        {% else %}
          <a class="search-result" href="{{ item.url }}">
            <span class="eyebrow">{{ item.object_type }}</span>
            <h2>{{ item.title }}</h2>
          </a>
        {% endif %}
      {% else %}
        <p>No results found.</p>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Search lifestyle banner"
    }
  ]
}
{% endschema %}
