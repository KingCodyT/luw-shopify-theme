<section class="search-shell{% if search.performed %} search-shell--results{% endif %}">
  <div class="section-heading">
    <h1>Find Your LYFE.</h1>
  </div>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="What’s Your LYFE?">
    <button class="button button--primary" type="submit">Search</button>
  </form>
  {% if section.settings.banner_image != blank and search.performed == false %}
    <div class="search-banner">
      {% render 'responsive-image',
        image: section.settings.banner_image,
        sizes: '100vw',
        loading: 'eager',
        class: 'search-banner__image'
      %}
    </div>
  {% endif %}

  {% if search.performed %}
    {% assign search_query = search.terms | downcase %}
    {% assign search_words = search_query | split: ' ' %}

    <div class="collection-artwork__grid">
      {% assign results_found = 0 %}

      {% paginate collections.all.products by 250 %}
        {% for product in collections.all.products %}
          {% assign product_tags = product.tags | join: ' ' | downcase %}
          {% assign product_title = product.title | downcase %}
          {% assign product_type = product.type | downcase %}

          {% capture searchable_text %}
        {{ product_title }} {{ product_tags }} {{ product_type }}
      {% endcapture %}

          {% assign product_matches = true %}

          {% for word in search_words %}
            {% unless searchable_text contains word %}
              {% assign product_matches = false %}
              {% break %}
            {% endunless %}
          {% endfor %}

          {% if product_matches %}
            {% assign results_found = results_found | plus: 1 %}
            {% render 'artwork-tile', product: product %}
          {% endif %}
        {% endfor %}
      {% endpaginate %}

      {% if results_found == 0 %}
        <p>No results found.</p>
      {% endif %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Search lifestyle banner"
    }
  ]
}
{% endschema %}
