{% liquid
  assign image_aspect = section.settings.image_aspect_ratio
  assign card_lift_enabled = section.settings.enable_card_lift
  assign image_zoom_enabled = section.settings.enable_image_zoom
  assign shadow_intensity = section.settings.shadow_intensity
  assign animation_speed = section.settings.animation_speed
  assign section_width_class = section.settings.section_width
  assign mobile_columns = section.settings.mobile_columns
  assign tablet_columns = section.settings.tablet_columns
  assign desktop_columns = section.settings.desktop_columns
%}

<section
  class="league-hub league-hub--{{ section_width_class }}"
  data-section-id="{{ section.id }}"
  style="
    --league-hub-padding-top: {{ section.settings.padding_top }}px;
    --league-hub-padding-bottom: {{ section.settings.padding_bottom }}px;
    --league-hub-card-gap: {{ section.settings.card_gap }}px;
    --league-hub-section-max-width: {{ section.settings.section_max_width }}px;
    --league-hub-eyebrow-color: {{ section.settings.eyebrow_color }};
    --league-hub-heading-color: {{ section.settings.heading_color }};
    --league-hub-body-color: {{ section.settings.body_color }};
    --league-hub-eyebrow-font-size: {{ section.settings.eyebrow_font_size }}px;
    --league-hub-heading-font-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
    --league-hub-heading-font-size-desktop: {{ section.settings.heading_font_size_desktop }}px;
    --league-hub-body-font-size: {{ section.settings.body_font_size }}px;
    --league-hub-heading-max-width: {{ section.settings.heading_max_width }}px;
    --league-hub-text-align: {{ section.settings.text_alignment }};
    --league-hub-image-aspect-ratio: {{ image_aspect }};
    --league-hub-card-bg: {{ section.settings.card_bg_color }};
    --league-hub-card-border-color: {{ section.settings.card_border_color }};
    --league-hub-card-border-width: {{ section.settings.card_border_width }}px;
    --league-hub-card-border-radius: {{ section.settings.card_border_radius }}px;
    --league-hub-card-shadow-intensity: {{ section.settings.shadow_intensity }};
    --league-hub-button-bg: {{ section.settings.button_bg_color }};
    --league-hub-button-text: {{ section.settings.button_text_color }};
    --league-hub-button-border-radius: {{ section.settings.button_border_radius }}px;
    --league-hub-button-hover-bg: {{ section.settings.button_hover_bg_color }};
    --league-hub-button-hover-text: {{ section.settings.button_hover_text_color }};
    --league-hub-button-size: {{ section.settings.button_size }};
    --league-hub-card-lift: {% if card_lift_enabled %}-6px{% else %}0{% endif %};
    --league-hub-image-zoom: {% if image_zoom_enabled %}1.05{% else %}1{% endif %};
    --league-hub-animation-speed: {{ animation_speed }}ms;
    --league-hub-mobile-columns: {{ mobile_columns }};
    --league-hub-tablet-columns: {{ tablet_columns }};
    --league-hub-desktop-columns: {{ desktop_columns }};
  "
>
  <div class="league-hub__container league-hub__container--{{ section_width_class }}">
    <div class="league-hub__header">
      <p class="league-hub__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="league-hub__heading">{{ section.settings.heading }}</h2>
      {% if section.settings.body_text != blank %}
        <p class="league-hub__body">{{ section.settings.body_text }}</p>
      {% endif %}
    </div>

    <div class="league-hub__grid">
      {% for block in section.blocks %}
        {% liquid
          assign collection = block.settings.collection
          assign image = block.settings.image | default: collection.featured_image
          assign league_url = block.settings.button_url | default: collection.url
        %}
        <a
          class="league-card"
          href="{{ league_url }}"
          {{ block.shopify_attributes }}
          style="
            --league-card-accent-color: {{ block.settings.accent_color }};
            --league-card-button-bg: {{ block.settings.button_bg_color }};
            --league-card-button-text: {{ block.settings.button_text_color }};
            --league-card-bg-override: {{ block.settings.card_bg_color_override }};
            --league-card-border-color-override: {{ block.settings.card_border_color_override }};
          "
        >
          <div class="league-card__image-wrap">
            {% render 'responsive-image',
              image: image,
              sizes: '(min-width: 990px) 30vw, (min-width: 750px) 48vw, 100vw',
              class: 'league-card__image',
              loading: 'lazy'
            %}
          </div>
          <div class="league-card__content">
            <h3 class="league-card__title">{{ block.settings.league_name }}</h3>
            {% if block.settings.tagline != blank %}
              <p class="league-card__tagline">{{ block.settings.tagline }}</p>
            {% endif %}
            <span class="league-card__button">{{ block.settings.button_text }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "League Hub",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "LEAGUE HUB"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CHOOSE YOUR LEAGUE."
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Every league has its legends. Find your team and wear your LYFE."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "contained",
      "options": [
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "section_max_width",
      "min": 1000,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Section maximum width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "min": 1,
      "max": 2,
      "step": 1,
      "label": "Mobile columns",
      "default": 1
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Tablet columns",
      "default": 2
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Desktop columns",
      "default": 3
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Card spacing",
      "default": 20
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#D44D2E"
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow font size",
      "default": 12
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading font size (mobile)",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading font size (desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Maximum heading width",
      "default": 640
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#555555"
    },
    {
      "type": "range",
      "id": "body_font_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Body font size",
      "default": 18
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Card Design"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "default": "16 / 10",
      "options": [
        {
          "value": "4 / 5",
          "label": "4:5 (Portrait)"
        },
        {
          "value": "1 / 1",
          "label": "1:1 (Square)"
        },
        {
          "value": "16 / 9",
          "label": "16:9 (Landscape)"
        }
      ]
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#E8E8E8"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Card border width",
      "default": 1
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "shadow_intensity",
      "min": 0.5,
      "max": 2,
      "step": 0.1,
      "label": "Card shadow intensity",
      "default": 1
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 6
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button hover background color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "header",
      "content": "Hover Effects"
    },
    {
      "type": "checkbox",
      "id": "enable_card_lift",
      "label": "Enable card lift on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "label": "Enable image zoom on hover",
      "default": true
    },
    {
      "type": "select",
      "id": "animation_speed",
      "label": "Animation speed",
      "default": "300",
      "options": [
        {
          "value": "150",
          "label": "Fast"
        },
        {
          "value": "300",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Slow"
        },
        {
          "value": "750",
          "label": "Very slow"
        }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "league_card",
      "name": "League card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override card image"
        },
        {
          "type": "text",
          "id": "league_name",
          "label": "League name",
          "default": "League"
        },
        {
          "type": "textarea",
          "id": "tagline",
          "label": "Tagline",
          "default": "Your favorite league awaits."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL (overrides collection)"
        },
        {
          "type": "color",
          "id": "accent_color",
          "label": "Accent color",
          "default": "#D44D2E"
        },
        {
          "type": "color",
          "id": "button_bg_color",
          "label": "Button background color",
          "default": ""
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button text color",
          "default": ""
        },
        {
          "type": "color",
          "id": "card_bg_color_override",
          "label": "Card background color override",
          "default": ""
        },
        {
          "type": "color",
          "id": "card_border_color_override",
          "label": "Card border color override",
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "League Hub",
      "blocks": [
        {
          "type": "league_card",
          "settings": {
            "league_name": "NFL LYFE",
            "tagline": "Where Sundays become memories.",
            "button_text": "Explore NFL"
          }
        },
        {
          "type": "league_card",
          "settings": {
            "league_name": "MLB LYFE",
            "tagline": "For the love of the game.",
            "button_text": "Explore MLB"
          }
        },
        {
          "type": "league_card",
          "settings": {
            "league_name": "NBA LYFE",
            "tagline": "Above the rim. Beyond ordinary.",
            "button_text": "Explore NBA"
          }
        },
        {
          "type": "league_card",
          "settings": {
            "league_name": "NHL LYFE",
            "tagline": "Cold ice. Hot rivalries.",
            "button_text": "Explore NHL"
          }
        },
        {
          "type": "league_card",
          "settings": {
            "league_name": "College LYFE",
            "tagline": "Saturdays live forever.",
            "button_text": "Explore College"
          }
        },
        {
          "type": "league_card",
          "settings": {
            "league_name": "OG LUW",
            "tagline": "Where it all began.",
            "button_text": "Explore OG LUW"
          }
        }
      ]
    }
  ]
}
{% endschema %}
