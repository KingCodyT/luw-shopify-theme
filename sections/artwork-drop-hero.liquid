{% liquid
  assign hero_image = section.settings.image
  if hero_image == blank and section.settings.collection.featured_image != blank
    assign hero_image = section.settings.collection.featured_image
  endif
%}

<section class="drop-hero color-band" data-section-id="{{ section.id }}">
  <div class="drop-hero__media">
    {% if hero_image != blank %}
      {% render 'responsive-image',
        image: hero_image,
        sizes: '100vw',
        loading: 'eager',
        class: 'drop-hero__image'
      %}
    {% else %}
      <img
        src="{{ 'luw-sports-female-hero.png' | asset_url }}"
        alt="{{ section.settings.heading | escape }}"
        class="drop-hero__image"
        loading="eager"
        width="1672"
        height="941"
      >
    {% endif %}
  </div>
  <div class="drop-hero__copy">
    <p class="eyebrow">{{ section.settings.eyebrow | default: settings.drop_label }}</p>
    <h1>{{ section.settings.heading }}</h1>
    {% if section.settings.text != blank %}
      <p>{{ section.settings.text }}</p>
    {% endif %}
    <div class="drop-hero__actions">
      {% if section.settings.collection != blank %}
        <a class="button button--primary" href="{{ section.settings.collection.url }}">{{ section.settings.cta_label }}</a>
      {% endif %}
      {% if section.settings.secondary_link != blank %}
        <a class="button button--quiet" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Artwork drop hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Current drop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Lyfe U Want"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Short text",
      "default": "Original artwork released as limited wearable and collectible canvases."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Drop collection"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary button",
      "default": "View drop"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "Archive"
    }
  ],
  "presets": [
    {
      "name": "Artwork drop hero"
    }
  ]
}
{% endschema %}
