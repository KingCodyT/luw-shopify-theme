{% comment %}
  Lyfestyle Collections section
  Displays a set of collections with image, title, and link.
{% endcomment %}

<section class="lyf-collections">
  <div class="wrap">
    {% if section.settings.title != blank %}
      <h2 class="section-title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="collections-grid">
      {% for block in section.blocks %}
        {% assign col = collections[block.settings.collection] %}
        {% if col != blank %}
          <article class="collection-item">
            <a href="{{ col.url }}" aria-label="{{ col.title }}">
              {% if col.image != null %}
                {% render 'responsive-image',
                  image: col.image,
                  sizes: '(min-width: 990px) 33vw, 100vw',
                  class: 'lyf-collections__image'
                %}
              {% else %}
                <div class="placeholder-image"></div>
              {% endif %}
              <h3 class="collection-title">{{ col.title }}</h3>
              {% if block.settings.show_count %}
                <span class="product-count">{{ col.products_count }} products</span>
              {% endif %}
            </a>
          </article>
        {% endif %}
      {%- endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lifestyle Collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "LIFESTYLE COLLECTIONS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FIND YOUR THING."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Whatever makes life better, there’s a LYFE for it."
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Lifestyle Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Lifestyle Collections",
      "category": "Collections"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .lyf-collections .collections-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  .lyf-collections .collection-item {
    width: calc(33.333% - 13.333px);
  }
  .lyf-collections img {
    width: 100%;
    height: auto;
    display: block;
  }
{% endstylesheet %}
