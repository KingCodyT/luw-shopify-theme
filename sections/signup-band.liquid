<section class="signup-band" data-section-id="{{ section.id }}">
  <div class="signup-band__copy">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
  </div>

  {% form 'customer', class: 'signup-form' %}
    <input type="hidden" name="contact[tags]" value="newsletter, drop-notify">
    <label class="visually-hidden" for="SignupEmail-{{ section.id }}">Email</label>
    <input id="SignupEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="Email for next drop" required>
    <button class="button button--primary" type="submit">{{ section.settings.button_label }}</button>
    {% if form.posted_successfully? %}
      <p class="form-message">You are on the list.</p>
    {% endif %}
    {% if form.errors %}
      <p class="form-message">{{ form.errors | default_errors }}</p>
    {% endif %}
  {% endform %}
</section>

{% schema %}
{
  "name": "Signup band",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Next drop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get the release note before it opens."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Notify me"
    }
  ],
  "presets": [
    {
      "name": "Signup band"
    }
  ]
}
{% endschema %}
