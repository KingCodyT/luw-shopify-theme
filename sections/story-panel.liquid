<section class="story-panel" data-section-id="{{ section.id }}">
  <div class="story-panel__image-wrap">
    {% render 'responsive-image',
      image: section.settings.image,
      sizes: '(min-width: 990px) 50vw, 100vw',
      class: 'story-panel__image'
    %}
  </div>
  <div class="story-panel__copy">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <div class="rte">{{ section.settings.text }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Story panel",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A small chapter behind the drop."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Keep the story short before purchase. Let the artwork carry the first impression, then give collectors context lower on the page.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Story panel"
    }
  ]
}
{% endschema %}
