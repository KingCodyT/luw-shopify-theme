<section class="collection-worlds" data-section-id="{{ section.id }}">
  <div class="section-heading collection-worlds__heading">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}
      <p>{{ section.settings.text }}</p>
    {% endif %}
  </div>

  <div class="worlds-grid">
    {% for block in section.blocks %}
      {% liquid
        assign collection = block.settings.collection
        assign image = block.settings.image | default: collection.featured_image
        assign title = block.settings.title | default: collection.title
        assign link = collection.url | default: block.settings.link
      %}
      <a class="world-tile world-tile--{{ block.settings.tone }}" href="{{ link }}" {{ block.shopify_attributes }}>
        {% render 'responsive-image',
          image: image,
          sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
          class: 'world-tile__image'
        %}
        <span class="world-tile__content">
          <span class="eyebrow">{{ block.settings.label }}</span>
          <span class="world-tile__title">{{ title }}</span>
          {% if block.settings.description != blank %}
            <span class="world-tile__description">{{ block.settings.description }}</span>
          {% endif %}
        </span>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collection worlds",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by world"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Big collections with room to grow."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Sports, outdoors, racing, and lifestyle collections stay broad enough for large catalogs while each product still leads with artwork."
    }
  ],
  "blocks": [
    {
      "type": "world",
      "name": "Collection world",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Small label",
          "default": "World"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Artwork-led products for this lane."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Fallback link"
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Tone",
          "default": "charcoal",
          "options": [
            {
              "value": "charcoal",
              "label": "Charcoal"
            },
            {
              "value": "green",
              "label": "Field green"
            },
            {
              "value": "orange",
              "label": "Court orange"
            },
            {
              "value": "red",
              "label": "Stitch red"
            },
            {
              "value": "yellow",
              "label": "Racing yellow"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection worlds",
      "blocks": [
        {
          "type": "world",
          "settings": {
            "label": "Drop",
            "title": "New Drops",
            "description": "Fresh artwork and limited releases.",
            "tone": "charcoal"
          }
        },
        {
          "type": "world",
          "settings": {
            "label": "Sports",
            "title": "NFL",
            "description": "Game-day artwork without team-logo dependency.",
            "tone": "green"
          }
        },
        {
          "type": "world",
          "settings": {
            "label": "Sports",
            "title": "NBA",
            "description": "Court energy, city pride, and lifestyle canvases.",
            "tone": "orange"
          }
        },
        {
          "type": "world",
          "settings": {
            "label": "Sports",
            "title": "MLB",
            "description": "Diamond season artwork and summer staples.",
            "tone": "red"
          }
        },
        {
          "type": "world",
          "settings": {
            "label": "Outdoors",
            "title": "Fishing",
            "description": "Bass, water, weekends, and outdoor-life graphics.",
            "tone": "green"
          }
        },
        {
          "type": "world",
          "settings": {
            "label": "Racing",
            "title": "Racing",
            "description": "Speed, checkered flags, and track-day art.",
            "tone": "yellow"
          }
        }
      ]
    }
  ]
}
{% endschema %}
